# Copy to .env.local and fill in. Used by docker-compose.local.yml:
#   docker compose -f docker-compose.local.yml --env-file .env.local up -d --build

# --- WebUI (required) ---
# Password for the web interface login.
SERVICE_PASSWORD_HERMESWEBUI=change-me
# Host port to expose the WebUI on (container always listens on 8787).
HERMES_WEBUI_PORT=8787
# Pin the external WebUI image tag.
HERMES_WEBUI_TAG=0.51.92

# --- File ownership on shared volumes (recommended) ---
# Set these to your host user so files written in the containers stay
# readable/writable on the host. You can also pass them inline:
#   HERMES_UID=$(id -u) HERMES_GID=$(id -g) docker compose ... up
HERMES_UID=1000
HERMES_GID=1000

# --- Optional API-billed providers ---
# The claude-code provider needs NONE of these (it uses your Claude
# subscription via the claude CLI). Fill any you also want available.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
